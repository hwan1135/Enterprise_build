#!/usr/bin/env bash
#==============================================================
# Cloud-init user_data script — OpenSCAP DISA STIG Remediation
#==============================================================
# This script runs on first boot to:
#   1. Install OpenSCAP and SCAP Security Guide
#   2. Run DISA STIG profile remediation
#   3. Generate a scan report
#   4. Configure basic hardening that survives reboot
#==============================================================

set -euo pipefail

LOG_FILE="/var/log/stig-hardening.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "[$(date)] Starting DISA STIG hardening process..."

#--------------------------------------------------------------
# 1. Wait for network and package manager readiness
#--------------------------------------------------------------
echo "[$(date)] Waiting for network connectivity..."
for i in $(seq 1 30); do
    if curl -s --connect-timeout 2 http://169.254.169.254/latest/meta-data/instance-id >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

#--------------------------------------------------------------
# 2. Install OpenSCAP and SCAP Security Guide
#--------------------------------------------------------------
echo "[$(date)] Installing OpenSCAP and SCAP Security Guide..."
dnf install -y openscap-scanner scap-security-guide firewalld audit rsyslog chrony

#--------------------------------------------------------------
# 3. Enable and start essential services
#--------------------------------------------------------------
echo "[$(date)] Enabling essential services..."
systemctl enable --now firewalld
systemctl enable --now auditd
systemctl enable --now rsyslog
systemctl enable --now chronyd

#--------------------------------------------------------------
# 4. Run DISA STIG profile remediation via OpenSCAP
#--------------------------------------------------------------
# Profile: stig (DISA Security Technical Implementation Guide)
# This applies automated remediations from the SCAP Security Guide
#--------------------------------------------------------------
SCAP_PROFILE="${stig_profile}"
SCAP_DATASTREAM="/usr/share/xml/scap/ssg/content/ssg-rhel9-ds.xml"
SCAP_RESULTS_DIR="/var/log/openscap-reports"
mkdir -p "$SCAP_RESULTS_DIR"

echo "[$(date)] Running OpenSCAP STIG remediation with profile: $SCAP_PROFILE"

if [ -f "$SCAP_DATASTREAM" ]; then
    # Generate pre-remediation scan report
    echo "[$(date)] Generating pre-remediation scan report..."
    oscap xccdf eval \
        --profile "$SCAP_PROFILE" \
        --results "$SCAP_RESULTS_DIR/pre-remediation-results.xml" \
        --report "$SCAP_RESULTS_DIR/pre-remediation-report.html" \
        "$SCAP_DATASTREAM" || true

    # Apply remediations
    echo "[$(date)] Applying STIG remediations..."
    oscap xccdf eval \
        --profile "$SCAP_PROFILE" \
        --remediate \
        --results "$SCAP_RESULTS_DIR/post-remediation-results.xml" \
        --report "$SCAP_RESULTS_DIR/post-remediation-report.html" \
        "$SCAP_DATASTREAM" || true

    echo "[$(date)] STIG remediation complete."
    echo "[$(date)] Reports saved to $SCAP_RESULTS_DIR/"
else
    echo "[$(date)] WARNING: SCAP datastream not found at $SCAP_DATASTREAM"
    echo "[$(date)] Skipping OpenSCAP remediation. Manual hardening via Ansible required."
fi

#--------------------------------------------------------------
# 5. Basic hardening that complements OpenSCAP
#--------------------------------------------------------------
echo "[$(date)] Applying baseline hardening controls..."

# Ensure SELinux is enforcing
setenforce 1 2>/dev/null || true
sed -i 's/^SELINUX=.*/SELINUX=enforcing/' /etc/selinux/config

# Configure firewalld — allow only SSH (if key-based access is needed)
firewall-cmd --permanent --remove-service=dhcpv6-client 2>/dev/null || true
firewall-cmd --reload

# Disable unnecessary services
systemctl disable --now avahi-daemon 2>/dev/null || true
systemctl disable --now cups 2>/dev/null || true
systemctl disable --now nfs-server 2>/dev/null || true

# Set login banner (DoD required)
cat > /etc/issue << 'BANNER'
***************************************************************************
*                          WARNING NOTICE                                 *
***************************************************************************
This is a U.S. Government computer system. Unauthorized access is prohibited.
By accessing this system, you consent to monitoring and recording.
Unauthorized use may result in criminal prosecution.
***************************************************************************
BANNER

cp /etc/issue /etc/issue.net
cp /etc/issue /etc/motd

# Configure auditd for STIG compliance
cat > /etc/audit/rules.d/stig.rules << 'AUDIT_RULES'
# Ensure audit log files are not deleted
-e 2
# Make audit configuration immutable
# -f 2
# Watch key system files
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/hosts -p wa -k system_config
-w /etc/sysconfig/ -p wa -k system_config
-w /etc/inittab -p wa -k system_config
-w /etc/init.d/ -p wa -k system_config
-w /etc/cron.d/ -p wa -k cron
-w /etc/cron.daily/ -p wa -k cron
-w /etc/cron.hourly/ -p wa -k cron
-w /etc/cron.monthly/ -p wa -k cron
-w /etc/cron.weekly/ -p wa -k cron
-w /etc/crontab -p wa -k cron
-w /var/log/audit/ -p wa -k audit_log
-w /etc/audit/ -p wa -k audit_config
AUDIT_RULES

systemctl restart auditd

# Configure chrony for time synchronization
cat > /etc/chrony.conf << 'CHRONY'
# Use AWS NTP server (via IMDS)
server 169.254.169.123 prefer iburst

# Allow the system clock to be stepped in the first three updates
makestep 1.0 3

# Enable hardware timestamping
hwtimestamp *

# Specify directory for chrony drift file
driftfile /var/lib/chrony/drift

# Allow NTP client access from local network only
allow 127.0.0.1

# Log clock statistics
logdir /var/log/chrony
CHRONY

systemctl restart chronyd

echo "[$(date)] DISA STIG hardening process complete."
echo "[$(date)] Review OpenSCAP reports at $SCAP_RESULTS_DIR/"
