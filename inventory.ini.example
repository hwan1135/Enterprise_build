# Example Ansible Inventory
# Update with your EC2 instance IP/DNS and connection details
#
# Usage:
#   1. Copy this file to inventory.ini
#   2. Update the ansible_host with your instance IP
#   3. Update ansible_user if different (e.g., ec2-user for RHEL)
#   4. Ensure SSH key is accessible at the path in ansible.cfg

[stig_hosts]
# Replace with your EC2 instance private/public IP
stig-instance-1 ansible_host=10.0.1.100 ansible_user=ec2-user

[stig_hosts:vars]
# Can also use SSM connection plugin for keyless access:
# ansible_connection=aws_ssm
# ansible_aws_ssm_bucket_name=your-s3-bucket
# ansible_aws_ssm_region=us-east-1

# Or use standard SSH connection:
ansible_connection=ssh
ansible_ssh_private_key_file=~/.ssh/id_rsa
